# --- Permitteer sign-in (docs: permitteer docs/remoteit-desktop-login.md) -----------
# The BACKEND owns the OIDC flow; these are backend-process env (not VITE_*).
# Local dev loop: loopback redirect + the dev stage. Packaged builds set
# OAUTH_REDIRECT_MODE=scheme.
OAUTH_ISSUER="https://login.dev.remote.it"
OAUTH_CLIENT_ID="remoteit_desktop"
OAUTH_GRAPHQL_RESOURCE="https://graphql.dev.remote.it/graphql"
OAUTH_REDIRECT_MODE="loopback"
# Point the app at the dev-stage API (same audience the tokens are minted for):
# VITE_GRAPHQL_API="https://graphql.dev.remote.it/graphql"
BRAND=remoteit
AIRBRAKE_PROJECT_KEY="..."
VITE_PORTAL="..."
VITE_API_URL="..."
VITE_GRAPHQL_API="..."
VITE_GRAPHQL_BETA_API="..."
VITE_DEVELOPER_KEY="..."
VITE_WEBSOCKET_URL="..."
VITE_WEBSOCKET_BETA_URL="..."
VITE_ZENDESK_URL="..."
VITE_SEGMENT_PROJECT_PORTAL_KEY="..."
VITE_SEGMENT_PROJECT_KEY="..."